# ==========================================
# BYFEST FRONTEND ENVIRONMENT VARIABLES
# ==========================================

# 1. URL API Backend (Bisa menggunakan localhost untuk dev lokal atau Vercel backend untuk prod)
# Contoh Lokal: http://localhost:5000/api
# Contoh Vercel Production: https://byfest-backend.vercel.app/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# 2. (Opsional) URL Root Backend jika ingin dipisahkan dari API URL
# Contoh: http://localhost:5000 atau https://byfest-backend.vercel.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

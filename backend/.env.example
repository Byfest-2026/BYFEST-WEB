# ==========================================
# BYFEST BACKEND ENVIRONMENT VARIABLES
# ==========================================

PORT=5000
NODE_ENV=development

# Database PostgreSQL (Neon / Supabase / Local)
POSTGRES_URL=postgresql://user:password@ep-example.neon.tech/byfest_db?sslmode=require
# ATAU jika menggunakan parameter terpisah:
# DB_NAME=byfest_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# Cloudinary Media Storage (Untuk upload poster, dokumen, dan bukti transfer)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
